# Database Configuration
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# Server Port
PORT=5000

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# SMS Gateway (Zectagon / Fast2SMS)
ZECTAGON_API_KEY=your_zectagon_api_key
SMS_SENDER_ID=MEHRPL

# Email Gateway (Brevo / Sendinblue)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=no-reply@meharadvisory.com

# AWS Amazon Location Service
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_LOCATION_PLACE_INDEX=MeharDVRPlaceIndex
